using Gtk 4.0;
using Adw 1;

template $HowToPlayDialog: Adw.Dialog {
    content-height: 500;
    content-width: 600;
    css-classes: ["how-to-play-dialog"];

    Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            title-widget: Adw.CarouselIndicatorDots {
                carousel: carousel;
            };
        }

        Adw.Carousel carousel {
            allow-long-swipes: true;
            allow-scroll-wheel: true;
            spacing: 80;

            Adw.StatusPage {
                title: _("The Basics");
                description: _("The board consists of a 3x3 grid of blocks, each containing its own 3x3 subgrid.");
                icon-name: "applications-games-symbolic";
                width-request: 400;
                height-request: 500;
            }

            Adw.StatusPage {
                title: _("Rows & Columns");
                description: _("Each row and column must contain unique numbers without duplicates.");
                icon-name: "open-menu-symbolic";
                width-request: 400;
                height-request: 500;
            }

            Adw.StatusPage {
                title: _("Blocks Matter");
                description: _("Each block may only contain one of each number.");
                icon-name: "view-grid-symbolic";
                width-request: 400;
                height-request: 500;
            }

            Adw.StatusPage {
                title: _("Mistakes Happen");
                description: _("Incorrect entries will be highlighted in red.");
                icon-name: "dialog-error-symbolic";
                width-request: 400;
                height-request: 500;
            }
        }
    }
}
